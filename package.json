{
  "name": "bopit-recognition-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build-extension.mjs",
    "start": "node --env-file-if-exists=.env apps/recognition-server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/experience-smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "warm:outlines": "node scripts/warm-segmentation.mjs",
    "test:payments:browser": "node tests/payment-browser-smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
