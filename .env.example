# Keep the keys on this server only. Never put them in the extension or browser.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional second key, used for transient service failures (not quota bypass).
GEMINI_BACKUP_API_KEY=
CHANNEL3_API_KEY=your_channel3_api_key_here
# Signing secret for the endpoint configured in the Channel3 webhook dashboard.
CHANNEL3_WEBHOOK_SECRET=
# Persistent local data directory; keep this on a durable volume in deployments.
BOPIT_DATA_DIR=.local
# Change this if this exact model is unavailable in your account.
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup for initial recognition only; blank disables fallback. At most two attempts.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Supabase dashboard identity configuration; not currently populated for this repository.
# Use the project's publishable/anon key here. Never set a service-role key in VITE_* code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Retailer data uses the same Supabase Postgres project after applying dashboard migrations.
RETAIL_STORAGE=postgres
RETAIL_DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING
RETAIL_API_PORT=4320
RETAIL_API_HOST=127.0.0.1
RETAIL_DASHBOARD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Channel3 Product Discovery API key (US product catalog)

# PayPal Sandbox app credentials: server only.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Dashboard settings above can instead go in apps/retail-api/.env, which its
# npm start / npm run seed:demo commands load from that directory.
