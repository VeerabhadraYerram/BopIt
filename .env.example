# Keep the keys on this server only. Never put them in the extension or browser.
GEMINI_API_KEY=your_gemini_api_key_here
CHANNEL3_API_KEY=your_channel3_api_key_here
# Signing secret for the endpoint configured in the Channel3 webhook dashboard.
CHANNEL3_WEBHOOK_SECRET=
# Persistent local data directory; keep this on a durable volume in deployments.
BOPIT_DATA_DIR=.local
# Change this if this exact model is unavailable in your account.
GEMINI_MODEL=gemini-3.5-flash-lite

# Channel3 Product Discovery API key (US product catalog)

# PayPal Sandbox app credentials: server only.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Optional: signing secret from Channel3 webhook dashboard (Svix).
# Expose only /api/channel3/webhook through a secure public HTTPS ingress.
CHANNEL3_WEBHOOK_SECRET=
