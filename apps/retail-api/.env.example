# Same Supabase project as apps/dashboard/.env. Server-side configuration only.
# Use the public publishable/legacy anon key, not a service-role/secret key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Database connection string with the database password, URL-encoded if needed.
# Use a direct or session-pooler connection reachable from your machine.
# Keep TLS certificate verification enabled.
RETAIL_STORAGE=postgres
RETAIL_DATABASE_URL=
RETAIL_API_PORT=4320
RETAIL_API_HOST=127.0.0.1
RETAIL_DASHBOARD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
