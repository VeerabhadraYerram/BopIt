# Supabase project settings → API. The publishable anon key is intended for browser use.
# Never put a Supabase service-role/secret key in VITE_* variables or browser code.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Local API proxy paths. Production deployments should set these to the HTTPS API origin.
VITE_RETAIL_API_URL=/api/retail/v1
VITE_DASHBOARD_API_URL=/api/dashboard/v1
